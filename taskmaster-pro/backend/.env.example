SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///taskmaster.db
CORS_ORIGINS=http://localhost:5173
# Free local AI option (recommended): install Ollama, run `ollama pull qwen3:4b`, then use:
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:4b
# Paid OpenAI-compatible option: AI_PROVIDER=openai, AI_BASE_URL=https://api.openai.com/v1, and set AI_API_KEY.
# Password reset email (set an HTTPS frontend URL in production):
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
